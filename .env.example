# Copy this file to .env.local for local development. Set matching values in Vercel.
# Supabase: Project Settings > API. The anon key is public; never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend: create a secret API key and a Segment for newsletter subscribers.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM_EMAIL=newsletter@polishersdaelit.com.ng
NEWSLETTER_ADMIN_EMAIL=polishersdaelit@gmail.com
QUOTE_ADMIN_EMAIL=polishersdaelit@gmail.com
SITE_URL=https://www.polishersdaelit.com.ng

# Optional public profiles used by the site footer and email footer.
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=
